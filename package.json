{
  "name": "ai-council",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "author": "Aditya Singla",
  "description": "Invite-only multi-model AI council with debate, research, evals, and usage accounting.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adityasingla5/ai-council.git"
  },
  "bugs": {
    "url": "https://github.com/adityasingla5/ai-council/issues"
  },
  "homepage": "https://github.com/adityasingla5/ai-council#readme",
  "keywords": [
    "ai",
    "council",
    "openrouter",
    "supabase",
    "nextjs"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "audit": "npm audit --audit-level=high",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "check": "npm run lint && npm run typecheck && npm test",
    "check:release": "npm run check && npm run build && npm run audit"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.49.1",
    "lucide-react": "^1.34.0",
    "next": "16.3.3",
    "openai": "^7.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.23",
    "typescript": "^5.7.2",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "brace-expansion@<2": "1.1.18",
    "brace-expansion@>=2": "5.0.9",
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "sharp": "0.35.3"
  }
}
